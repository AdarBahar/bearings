{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$BEARINGS_HOME\" ]; then python3 \"$BEARINGS_HOME/scripts/lint_hook.py\"; fi",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
